# Optional overrides for local development. Nothing here is required - the API and
# the detector's local dev server already agree on matching defaults
# (http://localhost:8000). Export any you want to change in your shell before
# running `yarn dev`.

# Where apps/api looks for the local Python detector shim when running offline.
# DETECTOR_LOCAL_URL=http://localhost:8000

# Port the detector's local dev server (services/detector/dev_server.py) listens on.
# DETECTOR_PORT=8000

# Set to true to let the API accept strategy=textract (off by default - paid).
# TEXTRACT_ENABLED=true
