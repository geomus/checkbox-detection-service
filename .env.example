# Optional overrides for local development (yarn dev). Nothing here is required —
# the API and the detector's local dev server already agree on matching defaults
# (http://localhost:8000). Copy to .env only if you need to change a port.

# Where apps/api looks for the local Python detector shim when running offline.
# DETECTOR_LOCAL_URL=http://localhost:8000

# Port the detector's local dev server (services/detector/dev_server.py) listens on.
# DETECTOR_PORT=8000
