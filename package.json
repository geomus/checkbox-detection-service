{
  "name": "checkbox-detection-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "packageManager": "yarn@4.18.0+sha512.fcb8716fe7cd0eece141ffc18b92193a9df9204c1ba83189c288835223fc0bbe64af473bab0d5e9927a7daeb5caf2bb07eb2787cc9338ca040ea125f2a1f2f7e",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/geomus/checkbox-detection-service.git"
  },
  "author": "Nahuel Daneri <nahuel.daneri@outlook.com>",
  "license": "MIT",
  "scripts": {
    "dev": "yarn workspace api run build && node scripts/dev.mjs",
    "build": "yarn workspaces foreach --all run build",
    "test": "yarn workspaces foreach --all run test",
    "lint": "yarn workspaces foreach --all run lint",
    "deploy": "yarn build && yarn serverless deploy",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "serverless": "3",
    "serverless-better-credentials": "^2.0.1",
    "serverless-offline": "13.10.1",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "eslint --fix",
    "*.{js,jsx,ts,tsx,json,md}": "prettier --write"
  }
}
